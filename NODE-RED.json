    {
        "id": "52c8dd868727fae0",
        "type": "function",
        "z": "b2452d0af62d7491",
        "name": "Filtrar selecionado para cidade",
        "func": "const concelhos = Array.isArray(msg.payload)\n    ? [...new Set(msg.payload.filter(c => typeof c === \"string\" && c.trim()))]\n    : [];\n\nif (concelhos.length === 0) {\n    msg.topic = `\n        SELECT City, Price, price_per_m2, Age_of_Property\n        FROM listings.tabela\n        WHERE 1 = 0\n    `;\n\n    msg.payload = [];\n    return msg;\n}\n\nconst placeholders = concelhos.map(() => \"?\").join(\",\");\n\nmsg.topic = `\n    SELECT\n        City,\n        Price,\n        price_per_m2,\n        Age_of_Property\n    FROM listings.tabela\n    WHERE City IN (${placeholders})\n`;\n\nmsg.payload = concelhos;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1310,
        "y": 600,
