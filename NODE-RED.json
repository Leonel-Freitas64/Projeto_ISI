    {
        "id": "16f3705b0a32f6d3",
        "type": "function",
        "z": "b2452d0af62d7491",
        "name": "Filtrar selecionado",
        "func": "const rows = flow.get(\"imobRows\") || [];\nconst selected = Array.isArray(msg.payload) ? msg.payload : [];\n\nconst filtered = rows.filter(r =>\n    selected.includes(r.City ?? r.city)\n);\n\nconst metrics = [\n    {\n        key: \"mean_price\",\n        fallback: \"Mean(Price)\",\n        title: \"Preço médio dos imóveis (€)\"\n    },\n    {\n        key: \"mean_price_per_m2\",\n        fallback: \"Mean(price_per_m2)\",\n        title: \"Preço médio por m² (€)\"\n    },\n    {\n        key: \"mean_age_of_property\",\n        fallback: \"Mean(Age_of_Property)\",\n        title: \"Idade média dos imóveis (anos)\"\n    },\n    {\n        key: \"difference_percent\",\n        fallback: \"difference_percent\",\n        title: \"Diferença percentual (%)\"\n    }\n];\n\nreturn metrics.map(metric => ({\n    topic: metric.title,\n    payload: filtered\n        .map(r => ({\n            city: r.City ?? r.city,\n            value: Number(r[metric.key] ?? r[metric.fallback])\n        }))\n        .filter(p => Number.isFinite(p.value)),\n    action: \"replace\"\n}));",
