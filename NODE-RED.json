    {
        "id": "a1c38f1a549fe227",
        "type": "function",
        "z": "b2452d0af62d7491",
        "name": "configurar concelhos",
        "func": "const rows = msg.payload;\n\nif (!Array.isArray(rows)) {\n    node.error(\"A consulta MySQL não devolveu um array.\", msg);\n    return null;\n}\n\nflow.set(\"imobRows\", rows);\n\nreturn {\n    topic: \"carregar_concelhos\",\n    payload: rows\n};",
