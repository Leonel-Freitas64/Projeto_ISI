    {
        "id": "a34f1453a0554980",
        "type": "function",
        "z": "b2452d0af62d7491",
        "name": "Mostrar todas as cidades",
        "func": "const rows = Array.isArray(msg.payload)\n    ? msg.payload\n    : [];\n\nconst imoveis = rows.map(r => ({\n    City: r.City,\n    Price: Number(r.Price),\n    price_per_m2: r.price_per_m2 == null\n        ? null\n        : Number(r.price_per_m2),\n    Age_of_Property: r.Age_of_Property == null\n        ? null\n        : Number(r.Age_of_Property)\n}));\n\nconst pontos = imoveis\n    .filter(r =>\n        Number.isFinite(r.Price) &&\n        Number.isFinite(r.Age_of_Property)\n    )\n    .map(r => ({\n        series: r.City,\n        age: r.Age_of_Property,\n        price: r.Price\n    }));\n\nreturn [\n    {\n        payload: imoveis\n    },\n    {\n        payload: pontos,\n        action: \"replace\"\n    }\n];",
