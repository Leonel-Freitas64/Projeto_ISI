    {
        "id": "1233937cae79539e",
        "type": "ui-template",
        "z": "b2452d0af62d7491",
        "group": "758da356cb5bc739",
        "page": "",
        "ui": "",
        "name": "Selecionador de concelhos",
        "order": 1,
        "width": "8",
        "height": "9",
        "head": "",
        "format": "<template>\n  <div class=\"selector\">\n    <div class=\"heading\">\n      <div class=\"heading-text\">\n        <h3>Concelhos</h3>\n        <p>Escolhe os municípios que queres analisar.</p>\n      </div>\n      <span class=\"count\">{{ selected.length }} selecionados</span>\n    </div>\n\n    <input\n      v-model=\"search\"\n      type=\"text\"\n      placeholder=\"Pesquisar concelho...\"\n      class=\"search\"\n    />\n\n    <div class=\"actions\">\n      <button class=\"secondary\" @click=\"selectVisible\">\n        Selecionar visíveis\n      </button>\n      <button class=\"secondary\" @click=\"selected = []\">\n        Limpar\n      </button>\n    </div>\n\n    <div class=\"city-list\">\n      <label\n        v-for=\"city in filteredCities\"\n        :key=\"city\"\n        class=\"city\"\n      >\n        <input\n          type=\"checkbox\"\n          :value=\"city\"\n          v-model=\"selected\"\n        />\n        <span>{{ city }}</span>\n      </label>\n\n      <p v-if=\"filteredCities.length === 0\" class=\"empty\">\n        Não foram encontrados concelhos.\n      </p>\n    </div>\n\n    <button class=\"apply\" @click=\"sendSelection\">\n      Aplicar filtros <span>→</span>\n    </button>\n  </div>\n</template>\n\n<script>\n  export default {\n  data() {\n    return {\n      cities: [],\n      selected: [],\n      search: \"\"\n    }\n  },\n\n  computed: {\n    filteredCities() {\n      const query = this.search.trim().toLocaleLowerCase(\"pt\");\n\n      return this.cities.filter(city =>\n        city.toLocaleLowerCase(\"pt\").includes(query)\n      );\n    }\n  },\n\n  watch: {\n    msg: {\n      immediate: true,\n      handler(msg) {\n        if (\n          msg &&\n          msg.topic === \"carregar_concelhos\" &&\n          Array.isArray(msg.payload)\n        ) {\n          this.cities = [...new Set(\n            msg.payload\n              .map(row => row.City ?? row.city)\n              .filter(Boolean)\n          )].sort((a, b) => a.localeCompare(b, \"pt\"));\n        }\n      }\n    }\n  },\n\n  methods: {\n    selectVisible() {\n      this.selected = [...new Set([\n        ...this.selected,\n        ...this.filteredCities\n      ])];\n    },\n\n    sendSelection() {\n      this.send({\n        topic: \"concelhos\",\n        payload: this.selected\n      });\n    }\n  }\n}\n</script>\n\n<style>\n  .selector {\n    box-sizing: border-box;\n    width: 100%;\n    height: 460px;\n    padding: 10px 8px;\n\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n\n    overflow: hidden;\n    font-family: inherit;\n    color: var(--v-theme-on-surface, inherit);\n  }\n\n  .heading {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 10px;\n    margin-bottom: 12px;\n  }\n\n  .heading-text {\n    min-width: 0;\n  }\n\n  .heading h3 {\n    margin: 0;\n    font-size: 1.15rem;\n    font-weight: 650;\n  }\n\n  .heading p {\n    margin: 5px 0 0;\n    opacity: .7;\n    font-size: .85rem;\n  }\n\n  .count {\n    flex: 0 0 auto;\n    white-space: nowrap;\n    font-size: .75rem;\n    padding: 7px 10px;\n    border-radius: 20px;\n    background: rgba(128, 128, 128, .13);\n  }\n\n  .search {\n    box-sizing: border-box;\n    flex: 0 0 42px;\n    width: 100%;\n    min-width: 0;\n    padding: 0 13px;\n\n    border: 1px solid rgba(128, 128, 128, .35);\n    border-radius: 10px;\n    background: transparent;\n    color: inherit;\n    font: inherit;\n  }\n\n  .search:focus {\n    outline-offset: 2px;\n    border-color: rgb(var(--v-theme-primary, 25, 118, 210));\n  }\n\n  .actions {\n    flex: 0 0 auto;\n    display: flex;\n    gap: 10px;\n    margin: 12px 0;\n  }\n\n  .secondary {\n    flex: 1 1 0;\n    min-width: 0;\n    min-height: 42px;\n    padding: 9px 8px;\n\n    border: 1px solid rgba(128, 128, 128, .3);\n    border-radius: 8px;\n    background: transparent;\n    color: inherit;\n    cursor: pointer;\n    font: inherit;\n    font-size: .82rem;\n  }\n\n  .city-list {\n    flex: 1 1 auto;\n    min-height: 0;\n    width: 100%;\n    box-sizing: border-box;\n\n    overflow-y: auto;\n    overflow-x: hidden;\n\n    border: 1px solid rgba(128, 128, 128, .2);\n    border-radius: 10px;\n    padding: 4px 10px;\n\n    scrollbar-gutter: stable;\n  }\n\n  .city {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    min-height: 38px;\n    padding: 5px 4px;\n    box-sizing: border-box;\n\n    cursor: pointer;\n    border-bottom: 1px solid rgba(128, 128, 128, .1);\n  }\n\n  .city:last-child {\n    border-bottom: none;\n  }\n\n  .city input {\n    flex: 0 0 17px;\n    width: 17px;\n    height: 17px;\n    margin: 0;\n    accent-color: rgb(var(--v-theme-primary, 25, 118, 210));\n    cursor: pointer;\n  }\n\n  .city span {\n    min-width: 0;\n    overflow-wrap: anywhere;\n    font-size: .9rem;\n  }\n\n  .empty {\n    margin: 0;\n    opacity: .7;\n    font-size: .85rem;\n    text-align: center;\n    padding: 15px 0;\n  }\n\n  .apply {\n    flex: 0 0 auto;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    width: 100%;\n    min-height: 46px;\n    box-sizing: border-box;\n\n    margin-top: 12px;\n    padding: 10px 15px;\n\n    border: none;\n    border-radius: 10px;\n    background: rgb(var(--v-theme-primary, 25, 118, 210));\n    color: white;\n    font-weight: 600;\n    font-size: .9rem;\n    cursor: pointer;\n  }\n\n  .apply span {\n    font-size: 1.2rem;\n  }\n\n  @media (max-width: 420px) {\n    .selector {\n      padding-left: 4px;\n      padding-right: 4px;\n    }\n\n    .heading {\n      gap: 6px;\n    }\n\n    .count {\n      font-size: .7rem;\n      padding: 6px 7px;\n    }\n\n    .secondary {\n      font-size: .75rem;\n    }\n  }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
